# Copy these NAMES into your hosting dashboard (Render, Cloud Run, etc.).
# Never commit real values to GitHub. Do not put real values in this file.

# --- Required secrets ---
GEMINI_API_KEY=put-your-key-in-the-hosting-dashboard-not-here
APP_ACCESS_TOKEN=a-long-random-string-you-invent-also-typed-into-the-app

# --- Model selection (see README "Changing the model") ---
GEMINI_MODEL=gemini-flash-latest
# Optional: used automatically if the main model is rate-limited or unavailable.
GEMINI_FALLBACK_MODEL=

# --- Optional tuning ---
SYSTEM_PROMPT=
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.7
UPSTREAM_TIMEOUT_MS=25000
MAX_BODY_BYTES=400000
MAX_ATTACHMENTS=5
MAX_ATTACHMENT_CHARS=30000
MAX_ATTACHMENT_TOTAL_CHARS=60000
MAX_MESSAGES=100
MAX_MESSAGE_CHARS=4000
MAX_CONTEXT_CHARS=12000
# Longest personal-memory block the app may send with a message (Phase 4).
MAX_MEMORY_CHARS=3000
RATE_LIMIT_PER_MINUTE=20
DAILY_REQUEST_LIMIT=300

# Set to true when running behind a hosting proxy (Render, Cloud Run, Fly...).
TRUST_PROXY=true
# Local testing only. Never enable on a public server.
ALLOW_UNAUTHENTICATED=false

# ======================= Phase 4: multiple AI providers =======================
# Full guide: docs/PROVIDERS.md. Every provider is optional. Nothing here is a real value.

# Which provider answers by default, and the order tried when the USER has allowed fallback in the app.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_ORDER=
# Refuse fallback to any provider that might charge money, unless you say otherwise.
AI_FALLBACK_ALLOW_PAID=false
# Tell the server your Gemini billing situation (it cannot know): free | paid | unknown
GEMINI_BILLING=unknown
GEMINI_FALLBACK_ELIGIBLE=true

# Groq (OpenAI-compatible). No model is built in: use an id from GET /v1/providers/groq/models, or "auto".
GROQ_API_KEY=
GROQ_MODEL=
# free_only | metered | unknown. A fallback with "unknown" or "metered" cost is refused (see AI_FALLBACK_ALLOW_PAID).
GROQ_COST_POLICY=unknown
# Optional safety caps for small free plans (tokens per request / requests per minute).
GROQ_MAX_INPUT_TOKENS=
GROQ_RPM_LIMIT=

# OpenRouter. Paid models are blocked unless OPENROUTER_ALLOW_PAID=true.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_ALLOW_PAID=false
# deny = ask OpenRouter to avoid hosts that may store prompts (may reduce available models)
OPENROUTER_DATA_COLLECTION=deny

# Any other OpenAI-compatible service (https only; http only for localhost)
OPENAI_COMPAT_ID=compat
OPENAI_COMPAT_NAME=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_COST_POLICY=unknown

# Retry / protection tuning (defaults are conservative)
AI_MAX_ATTEMPTS_PER_PROVIDER=2
AI_MAX_TOTAL_ATTEMPTS=4
AI_BACKOFF_BASE_MS=400
AI_BACKOFF_CAP_MS=4000
AI_MAX_RETRY_WAIT_MS=5000
AI_REQUEST_DEADLINE_MS=50000
AI_BREAKER_THRESHOLD=3
AI_BREAKER_BASE_MS=15000
AI_BREAKER_MAX_MS=120000
AI_QUOTA_COOLDOWN_MS=900000
CHECK_RATE_LIMIT_PER_MINUTE=6
AI_ALLOW_USER_MODEL_SELECTION=true

# ======================= Phase 6b: Luxand.cloud face verification (optional) =======================
# 1:1 check only ("is this the enrolled person?"). Photos are sent to Luxand through this backend.
# The token is a SECRET: set it only in the hosting dashboard. If it was ever pasted anywhere public, rotate it first.
LUXAND_API_TOKEN=
# No default on purpose. Measure it (see docs) and set a value between 0 and 1; until then verify is disabled.
LUXAND_MIN_SIMILARITY=
# Only while calibrating: also return the score. Leave false in normal use.
FACE_RETURN_SCORE=false
FACE_RATE_LIMIT_PER_MINUTE=10
FACE_DAILY_LIMIT=200
FACE_MAX_PHOTO_BYTES=1000000
FACE_MAX_BODY_BYTES=1500000
FACE_UPSTREAM_TIMEOUT_MS=20000
